# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_PORT=5432
PORT=8001
UVICORN_PORT=8001

# Database URL for FastAPI application
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mydb
SECRET_KEY=replace-with-a-long-random-jwt-secret

# Optional: pgAdmin Configuration (uncomment if using pgAdmin)
# PGADMIN_EMAIL=admin@admin.com
# PGADMIN_PASSWORD=admin
# PGADMIN_PORT=5050


GOOGLE_CLIENT_ID=XXXX
GOOGLE_CLIENT_SECRET=XXXX
FRONTEND_BASE_URL=http://localhost:3001
BACKEND_URL=http://localhost:8001

# LiveKit Voice Agent Configuration
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# AI Provider Keys for Backend Voice Agent (OpenAI or Gemini)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8001/api/v1/scrum-master/calendar/google/callback
HUZL_WORKER_KEY=replace-with-a-long-random-worker-key
AGENT_SERVICE_KEY=replace-with-a-separate-long-random-agent-key
ENCRYPTION_KEY=replace-with-a-fernet-key

# Per-project context graphs (Neo4j + background projection worker)
CONTEXT_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-neo4j-password
NEO4J_DATABASE=neo4j
CONTEXT_DELEGATION_SECRET=replace-with-a-separate-long-random-context-secret
CONTEXT_EMBEDDINGS_ENABLED=false
CONTEXT_EXTRACTION_ENABLED=false
CONTEXT_EMBEDDING_MODEL=gemini-embedding-001
CONTEXT_EMBEDDING_DIMENSIONS=768
CONTEXT_MODEL=gemini-2.5-flash

# Google Cloud Storage (document bodies)
GCS_BUCKET_NAME=your-private-huzlr-bucket
GCS_PROJECT_ID=your-gcp-project-id
GCS_DOCUMENTS_PREFIX=project-documents
GCS_MAX_DOCUMENT_BYTES=2097152

# Vercel -> GCP keyless authentication. Leave these empty locally to use ADC.
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_SERVICE_ACCOUNT_EMAIL=vercel-storage@your-gcp-project-id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
