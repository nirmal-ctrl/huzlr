FROM docker:28-cli AS docker-cli
FROM python:3.13-slim
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /service
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/service/app
COPY requirements.ai-worker.txt ./requirements.ai-worker.txt
RUN pip install --no-cache-dir -r requirements.ai-worker.txt
COPY app ./app
CMD ["python", "-m", "ai_worker"]
