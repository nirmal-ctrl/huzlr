# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
# For SQLite local development, set DATABASE_CLIENT=sqlite
# For Neon DB / Production Postgres, set client=postgres and provide DATABASE_URL
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://user:password@host/database_name?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
