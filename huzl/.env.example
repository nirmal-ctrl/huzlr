# Worker-to-backend connection. This key must equal HUZL_WORKER_KEY in huzlr-be/.env.
HUZLR_BACKEND_URL=http://host.docker.internal:8001
HUZL_WORKER_KEY=replace-with-the-same-long-random-worker-key-as-the-backend

# Dedicated Google bot authentication. Provision this directory before starting the worker.
# auth-state.json is exported here so macOS authentication can be loaded by Linux Chromium.
BOT_PROFILE_DIR=/absolute/path/to/google-bot-profile
BOT_PROFILE_HOST_DIR=/absolute/path/to/google-bot-profile
BOT_STORAGE_STATE_PATH=/absolute/path/to/google-bot-profile/auth-state.json
REQUIRE_BOT_PROFILE=true

# Docker should stay headless. Set false when debugging the worker directly on a desktop.
HEADLESS=true

# Optional when running directly on macOS with installed Google Chrome.
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Development only. Real meeting audio requires the virtual PulseAudio devices in Docker.
USE_FAKE_MEDIA_DEVICE=false
